{
  "name": "openwolf",
  "version": "2.0.1",
  "description": "The second brain for Claude Code, now for every AI coding assistant: context management, architecture scaffolding, and smarter token utilization through lifecycle hooks.",
  "type": "module",
  "bin": {
    "openwolf": "./dist/bin/openwolf.js"
  },
  "scripts": {
    "prebuild": "node -e \"const fs=require('fs');if(fs.existsSync('dist'))fs.rmSync('dist',{recursive:true})\"",
    "build": "tsc && pnpm build:hooks && pnpm build:dashboard",
    "build:hooks": "tsc -p tsconfig.hooks.json",
    "build:dashboard": "cd src/dashboard/app && npx vite build --outDir ../../../dist/dashboard",
    "dev": "tsc --watch",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "prepublishOnly": "pnpm build",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "chokidar": "^4.0.0",
    "commander": "^12.0.0",
    "express": "^5.2.1",
    "node-cron": "^4.2.1",
    "open": "^10.0.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "AGPL-3.0-only",
  "author": "Cytostack Pvt Ltd",
  "repository": {
    "type": "git",
    "url": "https://github.com/cytostack/openwolf.git"
  },
  "homepage": "https://github.com/cytostack/openwolf",
  "bugs": {
    "url": "https://github.com/cytostack/openwolf/issues"
  },
  "keywords": [
    "claude",
    "ai",
    "context",
    "token",
    "openwolf",
    "claude-code",
    "developer-tools"
  ],
  "files": [
    "dist/",
    "src/templates/",
    "LICENSE",
    "README.md"
  ]
}
